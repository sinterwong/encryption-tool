@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(ENCRYPT_IS_STATIC @ENCRYPT_IS_STATIC@)

# 静态库需要找到 cryptopp
if(ENCRYPT_IS_STATIC)
    # 查找 cryptopp，它应该已经被安装
    find_dependency(cryptopp REQUIRED)
    
    # 确保别名存在
    if(TARGET cryptopp AND NOT TARGET cryptopp::cryptopp)
        add_library(cryptopp::cryptopp ALIAS cryptopp)
    elseif(TARGET cryptopp-static AND NOT TARGET cryptopp::cryptopp)
        add_library(cryptopp::cryptopp ALIAS cryptopp-static)
    endif()
endif()

# 包含 encrypt 的 targets 文件
include("${CMAKE_CURRENT_LIST_DIR}/encrypt-targets.cmake")

# 静态库模式：手动添加 cryptopp 到 encrypt 的接口
if(ENCRYPT_IS_STATIC AND TARGET encrypt::encrypt)
    set_property(TARGET encrypt::encrypt APPEND PROPERTY
        INTERFACE_LINK_LIBRARIES cryptopp::cryptopp
    )
endif()

check_required_components(encrypt)